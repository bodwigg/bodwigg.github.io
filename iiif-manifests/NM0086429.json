import json
import requests
from pathlib import Path

MANIFEST_ID = "https://ulfbodin.se/iiif_manifests/96c44227-518f-4c4f-84bb-98e83ce8971b.json"

# get a collection
def get_collection(uuid: str) -> dict:
	api_url = f'https://dokumentlager.nordiskamuseet.se/api/list/{uuid}'
	response = requests.get(api_url, auth=('arkiv', 'Cee0eefa'))
	return response.json()

# return a property	
def get_prop(entity, prop):
	return entity["properties"].get(prop, [{}])[0].get("value")

