# create a IIIF v 3 manifest
def create_manifest(uuid: str) ->  dict:
	
	# hämta data
	data = get_collection(uuid)
	
	# --- 1. Hitta boken (Collection)
	collection = next(e for e in data if e["entityType"] == "Collection")
	#book_title = collection["properties"]["entity.name"][0]["value"]["sv"]
	book_title =  f'Nordiska museets arkiv: {collection["caption"]["sv"]}'
	
	# --- 2. Hitta sidorna (Resource)
	pages = [e for e in data if e["entityType"] == "Resource"]

	# sortera på filnamn 00001, 00002, ...
	pages.sort(key=lambda e: get_prop(e, "entity.code"))

	canvases = []

	for i, page in enumerate(pages, start=1):
		page_uuid = page.get('uuid')
		label = page["properties"]["entity.name"][0]["value"]["sv"]
		# add page number
		label = f"Sida {str(i)}: {label}"
		img_url = page["properties"]["resource.originalFile"][0]["value"]["url"]
		# switch to IIIF server
		img_url = img_url.replace("?dimension=800x800","/full/full/0/default.jpg")
		
		transcript = page["properties"]["resource.transcript"][0]["value"]["sv"]

		# Image API v2 service-id
		service_id = img_url.split("/full/")[0]

		canvas_id = f"{MANIFEST_ID}/canvas/p{i}"

		canvas = {
			"id": canvas_id,
			"type": "Canvas",
			"label": {"sv": [label]},
			"items": [
				{
					"id": f"{canvas_id}/page/1",
					"type": "AnnotationPage",
					"items": [
						{
							"id": f"{canvas_id}/annotation/image",
							"type": "Annotation",
							"motivation": "painting",
							"target": canvas_id,
							"body": {
								"id": img_url,
								"type": "Image",
								"format": "image/jpeg",
								"service": [
									{
										"id": service_id,
										"type": "ImageService2",
										"profile": "http://iiif.io/api/image/2/level2.json"
									}
								]
							}
						}
					]
				}
			]
		}
		

		if transcript.strip():
			 # --- Transkription som metadata
			t_dict = {
					"label": "Transkription",
					"value": transcript
				}		
			
			# --- Transkription som text-annotation	
			# canvas["annotations"] = [
				# {
					# "id": f"{canvas_id}/annotations/transcription",
					# "type": "AnnotationPage",
					# "items": [
						# {
							# "id": f"{canvas_id}/annotation/transcription",
							# "type": "Annotation",
							# "motivation": "supplementing",
							# "target": canvas_id,
							# "body": {
								# "type": "TextualBody",
								# "value": transcript,
								# "language": "sv",
								# "format": "text/plain"
							# }
						# }
					# ]
				# }
			# ]
		
		else:
			# --- not transcribed
			t_dict = {
					"label": "Transkription",
					"value": "Inte transkriberad sida"
				}	
		u_dict = {
			"label": "Källa (URL)",
			"value": f"https://dokument.nordiskamuseet.se/resource/{uuid}?entryPoint={page_uuid}"		
		}
		
		canvas["metadata"] = [t_dict, u_dict]	
		

		canvases.append(canvas)

	manifest = {
		"@context": "http://iiif.io/api/presentation/3/context.json",
		"id": MANIFEST_ID,
		"type": "Manifest",
		"label": {"sv": [book_title]},
		"behavior": ["paged"],
		"viewingDirection": "left-to-right",
		"items": canvases
	}
	
	return manifest

uuid = "96c44227-518f-4c4f-84bb-98e83ce8971b"	
fn = f"c:\\output\\manifest_{uuid}.json"

with open(fn, "w", encoding="utf-8") as f:
	manifest = create_manifest(uuid)
	json.dump(manifest, f, ensure_ascii=False, indent=2)

print("manifest.json skapad")
